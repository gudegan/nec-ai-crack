  <EventHook event="OnSkinChange">
    <!--<Attribute control="text_title" value="textcolor=&quot;Global.DarkGray&quot;" />-->
  </EventHook>
  <VerticalLayout name="layout_clientrect"  inset="1,0,1,1" >
    <HorizontalLayout name="PopUpTitleHor">
      <Label theme="PopUpTitle" text="定时设置" />
      <Control />
      <Button name="button_Close" theme="PopUpCloseBtn"/>
    </HorizontalLayout>

    <HorizontalLayout name="AllButHeadArea" height="380">
      <!--bkimage="lefebk.png"-->
      <VerticalLayout   width="130"   text="导航按钮区"  bkcolor="#FFF9F9F9">
        <!-- 左侧选项卡 -->
        <Control height="17"></Control>
        <!--statusimage statusimage="nav_bt_bk.png"  selectedimage="nav_bt_bk_3.png"-->
        <Option  group="CfgBtnPanel"  width="130" height="44" align="center" textpadding="0,2" normalimage="nav_bt_bk_1.png" hotimage="nav_bt_bk_2.png"  selectedimage="nav_bt_bk_3.png" selectedtextcolor="#FF858585" name="setting_OptShutdown"  text="定时关机" />
        <Option  group="CfgBtnPanel"  width="130" height="44" align="center" textpadding="0,2" normalimage="nav_bt_bk_1.png" hotimage="nav_bt_bk_2.png"  selectedimage="nav_bt_bk_3.png" selectedtextcolor="#FF858585" name="setting_OptPlay"  text="定时播放" />
        <Option  group="CfgBtnPanel"  width="130" height="44" align="center" textpadding="0,2" normalimage="nav_bt_bk_1.png" hotimage="nav_bt_bk_2.png"  selectedimage="nav_bt_bk_3.png" selectedtextcolor="#FF858585" name="setting_OptStop"  text="定时停止" />

      </VerticalLayout >
      <!--bkcolor="#f8ffffff"-->
      <VerticalLayout name="PanelItemTabAndApplyArea"  bkcolor="#f8ffffff">
        <TabLayout name="setting_Tab"  inset="35,0,0,0" height="324" vscrollbar="false" >

          <VerticalLayout childpadding="6,0,0,0" >
            <!---第一个选项设置  -->
            <HorizontalLayout name="layout_setnull" height="14" padding="15,32,0,0">
              <Option name="option_setnull"  group="ShutDownType" selected="true" text="不设置自动关机" theme="PopUpSingleSel"/>
            </HorizontalLayout>
            <HorizontalLayout name="layout_downfinish" height="14" padding="15,24,0,0">
              <Option name="option_downfinish"  group="ShutDownType" text="下载完成后自动关机" theme="PopUpSingleSel"/>
            </HorizontalLayout>
            <HorizontalLayout name="layout_poweroff" height="14" padding="15,24,0,0">
              <Option  name="option_timing" group="ShutDownType" text="设置定时关机" theme="PopUpSingleSel"/>
            </HorizontalLayout>
            <HorizontalLayout name="layout_timing" childpadding="5,0,0,0" height="30" padding="15,11,0,0" >
              <Label  varwidth="true" height="30" padding="24,0,0,0"  text="关机时间:" />
              <Combo name="combo_hour"  width="66"  height="30"  padding="0,0,0,0" itemdisabledtextcolor="#33333333" />
              <!-- padding="0,2,0,0" padding="5,2,0,0"-->
              <Combo name="combo_minute" width="66" height="30"  padding="0,0,0,0" />
            </HorizontalLayout>

          </VerticalLayout>


          <VerticalLayout childpadding="6,0,0,0">
            <!-- 第二个选项设置-->

            <HorizontalLayout name="layout_playsetnull" height="14" padding="15,32,0,0">
              <Option name="option_playsetnull" group="TimingPlay" selected="true" text="不设置定时播放" theme="PopUpSingleSel"/>
            </HorizontalLayout>
            <HorizontalLayout name="layout_playset" height="14" padding="15,24,0,0" >
              <Option name="option_playset" group="TimingPlay"  text="设置定时播放" theme="PopUpSingleSel"/>
            </HorizontalLayout>
            <HorizontalLayout height="30" padding="15,7,0,0" childpadding="5,0,0,0">
              <Label  varwidth="true" height="30" padding="24,0" text="开始时间："  />
              <Combo name="combo_playhour" width="66"  height="30"  />
              <Combo name="combo_playminute"  width="66" height="30" />
            </HorizontalLayout>
            <HorizontalLayout height="25" padding="15,2,0,0" childpadding="5,0,0,0">
              <Label text="定时播放的歌曲" varwidth="true" padding="24,0" ></Label>
            </HorizontalLayout>

            <HorizontalLayout height="30" padding="40,8,0,0" >
              <Label text="列表:" width="60" height="30" />
              <Combo name="combo_list" width="305" height="30" itemendellipsis="true" />
            </HorizontalLayout>
            <HorizontalLayout height="30" padding="40,9,0,0">
              <Label text="曲目:" width="60" height="30" ></Label>
              <Combo name="combo_song" width="305" height="30" itemendellipsis="true" > </Combo>
            </HorizontalLayout>
          </VerticalLayout>

          <VerticalLayout childpadding="6,0,0,0">
            <!-- 第三个选项设置-->
            <Control height="12" />
            <HorizontalLayout  height="14" padding="15,14,0,0" >
              <Option name="option_setnullstopplay" group="TimingStop" selected="true" text="不设置定时停止播放" theme="PopUpSingleSel"/>
            </HorizontalLayout>
            <HorizontalLayout  height="14" padding="15,24,0,0" >
              <Option name="option_setstopplay"  group="TimingStop"  text="设置定时停止播放"  theme="PopUpSingleSel"/>
            </HorizontalLayout>
            <HorizontalLayout height="30" padding="40,11,0,0" >
              <Label  width="70" height="25" text="停止时间："  />
              <Combo name="combo_stophour" width="66"  height="30"  />
              <Combo name="combo_stopminute" width="66" height="30" padding="8,0"/>
            </HorizontalLayout>
          </VerticalLayout>

        </TabLayout>
        <HorizontalLayout name="layout_opbutton"  padding="136,0,0,0" height="32" align="left" >
          <Button name="button_comfort" text="确认"  width="104" height="32" theme="MsgBox_Btn_Focus"/>
          <Button name="button_cancel" text="取消"  width="104" height="32" theme="PopUpDefBtn" padding="14,0"/>
          <Button name="button_apply" text="应用" width="104" height="32" theme="PopUpDefBtn" padding="14,0" enabled="false" />
        </HorizontalLayout>
      </VerticalLayout>

    </HorizontalLayout>

  </VerticalLayout>
</Window>