        <Control />
        <Button name="goback" padding="0,10,10,0" width="30" height="30" statusimage="popupwndcloseVir.png"/>
      </HorizontalLayout>

      <VerticalLayout  inset="28,0,26,0">
        <VerticalLayout name="mks.canvas" bkcolor="#ff98A1B3" inset="82,47,82,47" userdata="mks.sizer.png" bordersize="8">
          <VerticalLayout name="mks.root" bkimage="msk.previewborder.png" inset="2,2,2,2">
            <HorizontalLayout name="mks.body">
              <VerticalLayout name="mks.nav" width="113" theme="mks.navbk">
                <HorizontalLayout height="54" inset="18,15,0,14">
                  <Control name="mks.userphoto" width="25" height="25" bkimage="mks.userphoto.png"/>
                  <VerticalLayout inset="7,3,0,0">
                    <Control name="mks.user.text1" width="38" height="6" theme="mks.colorbars"/>
                    <Control height="6" />
                    <Control nam="mks.user.text2" width="46" height="6" theme="mks.colorbars"/>
                  </VerticalLayout>
                </HorizontalLayout>
                <VerticalLayout>
                  <List name="mks.navs" theme="mks.navlist">
                    <DefChildAttr height="22" inset="22,4,0,4"/>
                    <ListContainerElement name="mks.nav0" selected="true">
                      <HorizontalLayout>
                        <Control name="icon" width="14" height="14" theme="mks.colorbars" />
                        <Label name="text" theme="mks.NavChildText" padding="7,0,0,0" text="推荐" />
                      </HorizontalLayout>
                    </ListContainerElement>
                    <ListContainerElement name="mks.nav1">
                      <HorizontalLayout>
                        <Control name="icon" width="14" height="14" theme="mks.colorbars" />
                        <Label name="text" theme="mks.NavChildText" padding="7,0,0,0" text="电台" />
                      </HorizontalLayout>
                    </ListContainerElement>
                    <ListContainerElement name="mks.nav2">
                      <HorizontalLayout>
                        <Control name="icon" width="14" height="14" theme="mks.colorbars" />
                        <Label name="text" theme="mks.NavChildText" padding="7,0,0,0" text="视频" />
                      </HorizontalLayout>
                    </ListContainerElement>
                    <ListContainerElement name="mks.nav3">
                      <HorizontalLayout>
                        <Control name="icon" width="14" height="14" theme="mks.colorbars" />
                        <Label name="text" theme="mks.NavChildText" padding="7,0,0,0" text="直播" />
                      </HorizontalLayout>
                    </ListContainerElement>
                  </List>

                </VerticalLayout>

              </VerticalLayout>

              <VerticalLayout name="mks.netsong" inset="13,0,13,0">
                <DefChildAttr theme="mks.ListLabelSongList" />

                <HorizontalLayout height="134" inset="0,13,14,21">
                  <Control name="mks.albumpic" width="100" height="100" bkimage="mks.albumpic.png" bkcolor="0x0f000000" />
                  <VerticalLayout padding="13,0,0,0">
                    <Label name="mks.albumtitle" theme="mks.ListLabelSongList" font="Default.Font18" varwidth="true" text="酷我最热音乐歌单" />
                    <Label name="mks.albuminfo1" width="150" height="8" padding="0,10,0,0" theme="mks.colorbars" />
                    <Label name="mks.albuminfo2" width="273" height="12" padding="0,4,0,0" theme="mks.colorbars" />
                    <Button name="mks.playall" theme="mks.ListBtnPlay" width="68" height="26" padding="0,14,0,0" icondest="14,8,22,19" textpadding="10,0,0,0" text="播放" />
                  </VerticalLayout>
                </HorizontalLayout>

                <HorizontalLayout height="24" theme="mks.colorbars">
                  <DefChildAttr align="center" theme="mks.ListHeader" font="Default.FontSmall"/>
                  <Label text="歌名" />
                  <Label text="歌手" />
                  <Label text="专辑" />
                  <Label text="音质" />
                </HorizontalLayout>
                <Control height="4" />
                <Label text="你最喜欢的音乐单曲01" font="Default.FontSmall" theme="mks.colorbars"/>
                <Control height="4" />
                <Label text="你最喜欢的音乐单曲02" font="Default.FontSmall" theme="mks.colorbars"/>
                <Control height="4" />
                <Label text="你最喜欢的音乐单曲03" font="Default.FontSmall" theme="mks.colorbars"/>
              </VerticalLayout>


            </HorizontalLayout>

            <HorizontalLayout name="mks.playcontrol" height="48" theme="mks.playcontrolbk">
              <DefChildAttr bordercolor=""/>
              <Button name="mks.pre" bkimage="mks.pre.png" width="32" height="32" padding="12,8,0,8"/>
              <Button name="mks.play" bkimage="mks.play.png" width="40" height="40" padding="12,4,0,4"/>
              <Button name="mks.next" bkimage="mks.next.png" width="32" height="32" padding="12,8,0,8"/>
              <Slider name="mks.progress" enabled="false" padding="7,15,0,0" height="18" fgimage="mks.progressfg.png" bkimage="mks.progressbk.png" thumbimage="mks.progressthumb.png" thumbdisabledimage="mks.progressthumb_1.png" thumbsize="16,16" value="80"/>
              <Control width="17" height="17" padding="13,15,0,0" theme="mks.colorbars" />
              <Control width="17" height="17" padding="13,15,0,0" theme="mks.colorbars" />
              <Control width="17" height="17" padding="13,15,0,0" theme="mks.colorbars" />
              <Control width="17" height="17" padding="13,15,18,0" theme="mks.colorbars" />
            </HorizontalLayout>
          </VerticalLayout>

        </VerticalLayout>

        <HorizontalLayout height="72" inset="0,16,0,18">
          <Button name="colorscheme" align="left" setcursor="true" padding="0,8,0,8" text="文字色:" textcolor="pp.Text.Normal" iconimage="mks.colorscheme.png" icondest="50,3,66,19" width="70" />
          <Control width="18" />
          <Button name="topiccolor" align="left" setcursor="true" padding="0,8,0,8" text="主题色:" textcolor="pp.Text.Normal" iconimage="mks.topiccolor.png" icondest="50,1,70,21" width="70" />
          <Control />
          <Button name="resetimage" text="恢复默认" theme="PopUpDefBtn" width="90" tooltip="恢复图片初始大小"/>
          <Control width="12" />
          <Button name="pickimage" text="重新选图" theme="PopUpDefBtn" width="90" />
          <Control width="12" />
          <Button name="finish" text="完成制作" theme="ListBtnFocus" width="90" />
        </HorizontalLayout>

        <ColorPickerUI name="ColorPicker" float="true" visible="false" pos="135,280,0,0" width="216" height="160" initcolor="#color11" preview="cp.preview" picker="cp.picker" slider="cp.slider"></ColorPickerUI>
      </VerticalLayout>
    </VerticalLayout>
  </TabLayout>

</Window>








