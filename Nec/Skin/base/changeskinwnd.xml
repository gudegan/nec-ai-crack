              <HorizontalLayout name="serverthemetag_" theme="skingtagbar" />
              <TileLayout name="serverthemepanel" vscrollbar="true"/>
            </VerticalLayout>
            <VerticalLayout name="serverskinpage">
              <Control height="13" />
              <HorizontalLayout name="serverskintag_" theme="skingtagbar" />
              <TileLayout name="serverskinpanel" vscrollbar="true"/>
            </VerticalLayout>
            <VerticalLayout name="localskinpanel" vscrollbar="true" inset="0,13,0,0">
              <HorizontalLayout name="themetitle" height="33">
                <Label align="left" varwidth="true" text="主题皮肤" textcolor="Global.DarkGray"/>
              </HorizontalLayout>
              <TileLayout name="localthemes" />

              <HorizontalLayout name="skintitle" height="40" inset="0,10,0,0">
                <Label text="背景皮肤" textcolor="Global.DarkGray"/>
              </HorizontalLayout>
              <TileLayout  name="localskins" />
            </VerticalLayout>
          </TabLayout>
          <Control height="1" bkcolor="#0f000000" />
          <VerticalLayout height="64" padding="30,0,28,0">
            <HorizontalLayout>
