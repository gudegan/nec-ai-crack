<?xml version="1.0" encoding="UTF-8"?>
<Skin>
  <!--深色皮肤无需引用基类皮肤<include name="${base}skin-dark.xml"/>-->
  <Color>
    <!--整体蒙版颜色（通常全透明即可）
	音乐盒背景从上至下分3层
    （1）netsongbk.jpg（浅色皮肤需设置）
    （2）Body.Mask（纯色皮肤需设置）
    （3）bk.jpg（所有皮肤均需设置）
	-->
    <Color name="Body.Mask" value="#00000000" />
	<!--前两位为反色阈值，后六位为蒙版颜色-->	
    <Color name="Pl.Mask" value="#60FFFFFF" />
    <!--左侧主菜单蒙版颜色-->
    <Color name="ListAera.Mask" value="#33000000" />
    <!--窗体背景色，皮肤未加载时展示的颜色，对应conf.ini里的maskcolor（10进制）-->    
	<Color name="Main.Bk" value="#FF273655" />

    <!--主题颜色-->
    <Color name="Topic.Normal" value="#FF7E84E7" />
    <!--主题色备选色，如复选框选中、顶部ICO指上，除官方白之外，需与主题颜色配置成相同颜色-->
    <Color name="Topic.Alter" value="#FF7E84E7" />
    <!--超链接色，高亮文字或链接文字指上色-->
    <Color name="Topic.LinkText" value="#FF7E84E7" />
	<!--高音质色-->
	<Color name="Global.Golden" value="#FFDFAB45" />
 	<!--异常色，通常为红色-->
    <Color name="Global.ErrRed" value="#FFFF6161" />
	<!--左侧主菜单指上颜色-->
    <Color name="Topic.Menu.Hot" value="#337E84E7" />
	 <!--左侧主菜单选中颜色-->
    <Color name="Topic.Menu.Selected" value="#807E84E7" />

    <!--播控栏底色-->
    <Color name="PlayControlPanel.bkcolor.normal" value="#E5141531" />
  </Color>
</Skin>